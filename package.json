{
  "name": "otel-genai-fleet-summary-action",
  "version": "0.1.0",
  "description": "GitHub Action wrapping otel-genai-fleet-summary. Walks a dir of OTLP span exports, counts by model, flags missing-model / unauthorized-model / high-error-rate, posts a Markdown summary as a PR comment, fails on high-severity findings. Completes the fleet-summary Action quintet across all 5 governance surfaces.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/otel-genai-fleet-summary-action"
  },
  "keywords": [
    "github-action",
    "actions",
    "opentelemetry",
    "otel",
    "genai",
    "fleet",
    "governance",
    "ai-governance",
    "kinetic-gain-suite",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
